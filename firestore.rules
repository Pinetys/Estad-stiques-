rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Teams collection
    match /teams/{teamId} {
      allow read, write: if true;
    }
    
    // Matches collection
    match /matches/{matchId} {
      allow read, write: if true;
    }
    
    // App state / sync metadata
    match /metadata/{docId} {
      allow read, write: if true;
    }
  }
}
